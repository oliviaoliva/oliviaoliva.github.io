---
import { work } from '../data/work';
---

<section id="work" class="work">
  <div class="frame">
    <div class="inner">
      <header class="head" data-reveal>
        <span class="label">Selected work</span>
        <h2 class="h-section">From messy processes<br /><span>to production AI</span></h2>
        <p class="muted">
          Systems I designed and built. Each one starts with real, manual work and ends with an AI pipeline running in
          production.
        </p>
      </header>

      <div class="cards">
        {
          work.map((w, i) => (
            <article class="card" data-reveal style={`transition-delay:${(i % 3) * 80}ms`}>
              <div class="top">
                <span class="mono dom">{w.domain}</span>
                <h3>{w.title}</h3>
                <p>{w.summary}</p>
                <span class="btn btn-dark metric">
                  <b>{w.output.value}</b> <span class="dim">{w.output.label}</span>
                </span>
              </div>

              <!-- Mini UI: o pipeline como pequenos nós -->
              <div class="mini dots-bg" aria-label="Pipeline">
                {w.pipeline.map((step, j) => (
                  <div class:list={['step', { last: j === w.pipeline.length - 1 }]}>
                    <span class="n mono">{String(j + 1).padStart(2, '0')}</span>
                    {step}
                  </div>
                ))}
                <div class="stack">
                  {w.stack.slice(0, 4).map((s) => (
                    <span class="chip">{s}</span>
                  ))}
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .work {
    border-top: 1px solid var(--line);
  }
  .work .inner {
    padding-block: clamp(80px, 10vw, 130px);
  }
  .head {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 18px;
    margin-bottom: clamp(48px, 6vw, 72px);
  }
  .head p {
    max-width: 52ch;
    margin: 0;
    font-size: 15px;
  }

  .cards {
    display: grid;
    gap: 12px;
    grid-template-columns: 1fr;
  }
  @media (min-width: 720px) {
    .cards {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1040px) {
    .cards {
      grid-template-columns: repeat(6, 1fr);
    }
    .card {
      grid-column: span 2;
    }
    .card:nth-child(4),
    .card:nth-child(5) {
      grid-column: span 3;
    }
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 20px;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 6px;
    transition: border-color 0.3s, background 0.3s;
  }
  .card:hover {
    border-color: var(--line-2);
    background: #0e0e10;
  }
  .top {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
  }
  .dom {
    font-size: 10px;
    color: var(--gold);
  }
  h3 {
    margin: 0;
    font-size: 18px;
    font-weight: 500;
    letter-spacing: -0.025em;
    line-height: 1.25;
  }
  .top p {
    margin: 0;
    font-size: 13px;
    color: var(--muted);
    line-height: 1.55;
  }
  .metric {
    height: auto;
    min-height: 32px;
    padding: 6px 10px;
    font-size: 12px;
    font-weight: 400;
    cursor: default;
    margin-top: 6px;
    text-align: left;
    justify-content: flex-start;
    flex-wrap: wrap;
  }
  .metric b {
    font-weight: 600;
    color: #fff;
  }

  .mini {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 16px;
    border: 1px solid var(--line);
    border-radius: 6px;
  }
  .step {
    position: relative;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 10px;
    font-size: 12px;
    background: #f4f2f6;
    color: #111;
    border-radius: 4px;
    width: fit-content;
    max-width: 100%;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.35);
    transition: transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .step:nth-child(2) {
    margin-left: 16px;
  }
  .step:nth-child(3) {
    margin-left: 32px;
  }
  .step:nth-child(4) {
    margin-left: 48px;
  }
  .card:hover .step {
    transform: translateX(6px);
  }
  .n {
    font-size: 10px;
    color: #888;
  }
  .step.last {
    background: linear-gradient(100deg, #ff6a1a, #df2208 60%, #b150a2);
    color: #fff;
  }
  .step.last .n {
    color: rgba(255, 255, 255, 0.7);
  }
  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    margin-top: 10px;
  }
</style>
