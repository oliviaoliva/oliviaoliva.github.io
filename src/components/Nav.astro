---
import Logo from './Logo.astro';
---

<header class="nav">
  <div class="frame">
    <div class="bar inner">
      <nav class="left" aria-label="Sections">
        <a href="/#work">Work</a>
        <a href="/#about">About</a>
        <a href="/#lab">Lab</a>
      </nav>

      <a href="/" class="brand" aria-label="Olivia Oliva, home">
        <Logo size={22} />
        <span>Olivia Oliva</span>
      </a>

      <div class="right">
        <a href="/#contact" class="btn btn-bracket">Get in touch</a>
      </div>
    </div>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    background: linear-gradient(to bottom, rgba(2, 2, 2, 0.9), rgba(2, 2, 2, 0.6));
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
  }
  .frame {
    border-top: 1px solid var(--line);
    margin-top: 0;
  }
  .bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: 64px;
    border-bottom: 1px solid var(--line);
  }
  .left,
  .right {
    display: flex;
    align-items: center;
    gap: 24px;
    font-size: 13px;
  }
  .right {
    justify-content: flex-end;
  }
  .left a,
  .right > a:not(.btn) {
    text-decoration: none;
    color: var(--muted);
    transition: color 0.2s;
  }
  .left a:hover,
  .right > a:not(.btn):hover {
    color: #fff;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 9px;
    text-decoration: none;
    font-weight: 600;
    font-size: 17px;
    letter-spacing: -0.03em;
  }
  .btn {
    height: 34px;
    font-size: 13px;
  }
  @media (max-width: 720px) {
    .bar {
      grid-template-columns: auto 1fr;
    }
    .left,
    .hide-sm {
      display: none;
    }
    .brand {
      grid-column: 1;
    }
  }
</style>
