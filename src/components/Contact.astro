---
const email = 'olivia.costa.oliva@icloud.com';
const linkedin = 'https://www.linkedin.com/in/olivia-da-costa-oliva';

const cards = [
  { title: 'Open to', text: 'AI engineering roles and freelance projects: LLM pipelines, agents, computer vision.' },
  { title: 'Based in', text: 'Rio de Janeiro, Brazil. Working remotely across time zones.' },
  { title: 'Speaks', text: 'Portuguese (native), English (bilingual) and Spanish (full professional).' },
];
---

<section id="contact" class="contact">
  <div class="frame">
    <div class="stage">
      <div class="glow" aria-hidden="true"></div>
      <div class="grid inner">
        <div class="copy" data-reveal>
          <span class="label">Contact</span>
          <h2>Have a messy process that should be <em>intelligent?</em></h2>
          <p>Tell me what’s slow, manual or painful. I’ll tell you what AI can realistically do about it.</p>
          <div class="ctas">
            <a href={`mailto:${email}`} class="btn btn-light">Email me</a>
            <a href={linkedin} class="btn btn-glass" target="_blank" rel="noopener">LinkedIn ↗</a>
          </div>
        </div>

        <div class="cards" data-reveal>
          {
            cards.map((c) => (
              <div class="card">
                <h3>{c.title}</h3>
                <p>{c.text}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .contact {
    border-top: 1px solid var(--line);
  }
  .stage {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    background: #1a0700;
  }
  .glow {
    position: absolute;
    inset: -10%;
    z-index: -1;
    background:
      radial-gradient(40% 60% at 0% 100%, #fff1dc 0%, transparent 70%),
      radial-gradient(60% 80% at 25% 80%, #ff8a1f 0%, transparent 70%),
      radial-gradient(60% 70% at 70% 50%, #ff6a1a 0%, transparent 70%),
      radial-gradient(40% 60% at 100% 0%, #3a1200 0%, transparent 70%),
      radial-gradient(50% 50% at 100% 100%, #df2208 0%, transparent 70%);
    filter: blur(30px);
  }
  .grid {
    display: grid;
    gap: 40px;
    padding-block: clamp(64px, 9vw, 110px);
  }
  @media (min-width: 980px) {
    .grid {
      grid-template-columns: 0.9fr 1.1fr;
      align-items: center;
    }
  }
  .label {
    color: rgba(255, 255, 255, 0.85);
  }
  .label::before {
    background: #fff;
  }
  h2 {
    margin: 18px 0 16px;
    font-size: clamp(36px, 4.6vw, 58px);
    font-weight: 500;
    line-height: 1.02;
    letter-spacing: -0.045em;
    color: #fff;
  }
  h2 em {
    font-style: normal;
    background: linear-gradient(90deg, #fff, #ffe2c4);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .copy p {
    margin: 0 0 28px;
    max-width: 40ch;
    color: rgba(255, 255, 255, 0.85);
    font-size: 15px;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .cards {
    display: grid;
    gap: 10px;
    grid-template-columns: 1fr;
    padding: 10px;
    border-radius: 8px;
    background: rgba(40, 18, 6, 0.55);
    border: 1px solid rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }
  @media (min-width: 520px) {
    .cards {
      grid-template-columns: 1fr 1fr;
    }
    .card:last-child {
      grid-column: 1 / -1;
      min-height: 120px;
    }
  }
  .card {
    padding: 18px;
    border-radius: 6px;
    background: linear-gradient(160deg, rgba(255, 255, 255, 0.1), rgba(0, 0, 0, 0.35));
    border: 1px solid rgba(255, 255, 255, 0.1);
    min-height: clamp(96px, 30vw, 170px);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }
  .card h3 {
    margin: 0 0 8px;
    font-size: 16px;
    font-weight: 500;
    letter-spacing: -0.02em;
    color: #fff;
  }
  .card p {
    margin: 0;
    font-size: 13px;
    color: rgba(255, 255, 255, 0.78);
  }
</style>
